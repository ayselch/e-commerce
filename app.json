{
  "scheme": "myapp",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "icon": "./assets/images/nectarIcon.png",
  "splash": {
    "resizeMode": "cover",
    "backgroundColor": "#ffffff"
  },
  "ios": {
    "icon": "./assets/images/ios-dark.png",
    "supportsTablet": true
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "package": "com.ayselch.myapp"
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    "expo-router",
    "expo-font"
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {
      "origin": false
    },
    "eas": {
      "projectId": "eb48bf62-4773-4997-8bba-9282135f0503"
    }
  },
  "owner": "ayselch"
}
